{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "ignorePaths": ["**/test/**"],
  "ignoreDeps": ["github.com/projectsveltos/sveltos-enterprise"],
  "sveltos": {
    "fileMatch": ["^.*\\.yaml$"]
  }
}
